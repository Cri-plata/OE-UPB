# Configuración local de ejemplo. No guardar secretos reales.
DATABASE_URL=mysql+pymysql://oeupb_user:change_me@localhost:3306/oeupb
SECRET_KEY=replace_with_a_long_random_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:4200
LOG_LEVEL=INFO
INITIAL_CREDENTIAL_MODE=documento
TEMPORARY_CREDENTIAL_EXPIRE_HOURS=24
RECOVERY_CREDENTIAL_EXPIRE_MINUTES=60
