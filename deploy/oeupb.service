# ==============================================================================
# SERVICIO SYSTEMD - OBSERVATORIO DE EGRESADOS UPB (OE-UPB)
# Ubicacion en Ubuntu: /etc/systemd/system/oeupb.service
# Comandos de activacion:
#   sudo systemctl daemon-reload
#   sudo systemctl enable oeupb.service
#   sudo systemctl start oeupb.service
#   sudo systemctl status oeupb.service
# ==============================================================================

[Unit]
Description=Servicio de Aplicacion Observatorio de Egresados UPB (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Carpeta de despliegue en el servidor (ajustar si se instala en otra ruta, ej: /opt/oeupb)
WorkingDirectory=/opt/oeupb
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
