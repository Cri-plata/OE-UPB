# ==============================================================================
# UNIDAD DE SERVICIO SYSTEMD PARA RED HAT / RHEL
# PROYECTO: Observatorio de Egresados UPB (OE-UPB)
# RUTA EN EL SERVIDOR: /etc/systemd/system/oeupb.service
# ==============================================================================

[Unit]
Description=Observatorio de Egresados UPB (OE-UPB Contenedores)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/oeupb
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
